# THE ARCHIVE — Backend Environment Variables
# Copy to .env and fill in values before running

# Server port
PORT=3001

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# For production: NODE_ENV=production
# For production: set ALLOWED_ORIGINS to your real frontend domain
